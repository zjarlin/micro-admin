{
  "name": "@zjarlin/ui-server",
  "version": "0.1.0",
  "description": "通用页面的 TS 后端：Hono + zod + node:sqlite，schema 存储、CRUD 与配置热更新",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjarlin/micro-admin.git",
    "directory": "packages/ui-server"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sqlite-store": "./src/sqlite-store.ts",
    "./config": "./src/config.ts",
    "./app": "./src/app.ts"
  },
  "dependencies": {
    "@zjarlin/data-page": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./sqlite-store": {
        "types": "./dist/sqlite-store.d.ts",
        "default": "./dist/sqlite-store.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./app": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.js"
      }
    }
  }
}
