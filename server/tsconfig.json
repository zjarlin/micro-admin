{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "exclude": ["../src/shared/scada/library.ts"],
  "include": [
    "./**/*.ts",
    "../src/schema/**/*.ts",
    "../src/shared/scada/**/*.ts",
    "../src/shared/types.ts",
    "../src/shared/entity-status.ts"
  ]
}
