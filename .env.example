# 唯一默认值来源：复制为 .env.local 后按需覆盖。
# 本机开发监听地址；生产构建不受此项影响。
DEV_HOST=0.0.0.0
DEV_PORT=5174

# 应用标题（浏览器标签页）。
VITE_APP_TITLE=Micro Admin

# mock = 使用内置演示数据；http = 请求真实后端。
VITE_API_MODE=mock

# 仅 VITE_API_MODE=http 时生效。
# 后端接口带 /api 前缀时填 /api，配合 Vite 代理转发到 API_PROXY_TARGET。
VITE_API_BASE_URL=

# Vite 开发代理目标，只在 dev 服务器生效；路径按原样转发。
API_PROXY_TARGET=
