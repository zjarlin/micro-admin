# 唯一默认值来源：复制为 .env.local 后按需覆盖。
# 本机开发监听地址；生产构建不受此项影响。
DEV_HOST=0.0.0.0
DEV_PORT=5174

# 应用标题（浏览器标签页）。
VITE_APP_TITLE=Micro Admin

# mock = 使用内置演示数据；http = 请求真实后端。
VITE_API_MODE=mock

# 仅 VITE_API_MODE=http 时生效。后端挂在 /api 前缀时填 /api。
# 后端接口带 /api 前缀时填 /api，配合 Vite 代理转发到 API_PROXY_TARGET。
VITE_API_BASE_URL=

# Vite 开发代理目标，只在 dev 服务器生效；路径按原样转发。
API_PROXY_TARGET=

# ---------------------------------------------------------------------------
# 通用页面后端（server/）：独立进程，默认 127.0.0.1:5181。
# ---------------------------------------------------------------------------
# 监听地址与端口。
SERVER_HOST=127.0.0.1
SERVER_PORT=5181
# 资源与运行期数据的落盘目录（生产用 bind mount，如 /root/DockerCompose/micro-admin/data）。
DATA_DIR=.data
# 前端构建产物目录；存在时后端一并托管并与 API 同源。
STATIC_DIR=dist
# 允许跨域的来源，逗号分隔；同源部署留空。
CORS_ORIGINS=

# 联调真实后端时：
# VITE_API_MODE=http
# VITE_API_BASE_URL=/api
# API_PROXY_TARGET=http://127.0.0.1:5181
